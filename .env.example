# ZB Reader 环境变量配置

# ========== 认证 ==========
# NextAuth 密钥（请更改为一个安全的随机字符串，至少 32 字符）
# 生成方式：openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-change-this

# 应用 URL
NEXTAUTH_URL=http://localhost:3000

# ========== TTS 服务（可选） ==========
# 允许内网 TTS URL（仅用于开发/测试环境，生产环境应设为 false）
# true: 允许配置内网地址的 TTS 服务
# false/未设置: 拒绝内网地址（默认）
ZB_READER_ALLOW_PRIVATE_TTS_URLS=false

# ========== 日志 ==========
# 日志级别：debug, info, warn, error（默认: info）
ZB_READER_LOG_LEVEL=info
